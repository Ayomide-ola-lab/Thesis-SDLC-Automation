# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Rename or copy this file to .env in the repository root and supply your configuration:
#
#   cp .env.example .env
#

# Required: OpenAI API Key for GPT-4o vision and multi-agent synthesis
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Path to target repository (defaults to ../optArrow)
TARGET_REPO_PATH=
